85 5296</li> </ul>"},{"location":"about/#_3","title":"\u81f4\u8c22","text":"<ul> <li>\u200b\u5efa\u200b\u7ad9\u200b\u5de5\u5177\u200b\u662f\u200b MkDocs Material\uff0c\u200b\u611f\u8c22\u200b\u5f00\u6e90\u200b\u3002</li> </ul>"},{"location":"friends/","title":"\u53cb\u94fe","text":""},{"location":"courses/","title":"\u8bfe\u7a0b\u200b\u77e5\u8bc6\u5e93","text":"\u5b66\u79d1\u200b\u5730\u56fe\u200b<p>\u200b\u6570\u5206\u200b / \u200b\u9ad8\u4ee3\u200b / \u200b\u5b9e\u53d8\u200b / \u200b\u62d3\u6251\u200b\u601d\u7ef4\u200b\u5bfc\u56fe\u200b</p>  \u200b\u597d\u9898\u200b\u5899\u200b<p>\u200b\u7b54\u6848\u200b\u6298\u53e0\u200b</p>  \u200b\u9519\u9898\u200b\u672c\u200b<p>\u200b\u4e3a\u4f55\u200b\u505a\u9519\u200b</p>  \u200b\u5386\u5e74\u200b\u9898\u89e3\u200b<p>\u200b\u53ea\u653e\u200b\u601d\u8def\u200b</p>"},{"location":"courses/errors/","title":"\u9519\u9898\u200b\u672c","text":"<p>\u200b\u9519\u9898\u200b\u90fd\u200b\u4ea4\u7ed9\u200b\u5b89\u5b9d\u200b\u7ba1\u7406\u200b\uff0c\u200b\u70b9\u51fb\u200b\u6253\u5f00\u200b\uff08\u200b\u76f4\u63a5\u200b\u8fdb\u200b\"\u200b\u9519\u9898\u200b\"\u200b\u5206\u7c7b\u200b\uff09\uff1a</p>  \u200b\u6253\u5f00\u200b\u9519\u9898\u200b\u9898\u5e93\u200b<p>\u200b\u5b89\u5b9d\u200b\u7ba1\u7406\u200b \u00b7 \u200b\u53ef\u5b58\u200b\u3001\u200b\u53ef\u200b\u67e5\u200b\u3001\u200b\u53ef\u200b\u5220\u200b</p>"},{"location":"courses/exams/","title":"\u5386\u5e74\u200b\u9898\u89e3","text":"<p>\u200b\u5386\u5e74\u200b\u9898\u200b\u90fd\u200b\u4ea4\u7ed9\u200b\u5b89\u5b9d\u200b\u7ba1\u7406\u200b\uff0c\u200b\u6309\u200b \u200b\u79d1\u76ee\u200b \u2192 \u200b\u8003\u8bd5\u200b\u7c7b\u578b\u200b \u2192 \u200b\u5e74\u4efd\u200b \u200b\u5206\u7c7b\u200b\uff0c\u200b\u70b9\u51fb\u200b\u6253\u5f00\u200b\uff1a</p>  \u200b\u6253\u5f00\u200b\u5386\u5e74\u200b\u9898\u200b\u9898\u5e93\u200b<p>\u200b\u5b89\u5b9d\u200b\u7ba1\u7406\u200b \u00b7 \u200b\u6309\u200b\u79d1\u76ee\u200b/\u200b\u7c7b\u578b\u200b/\u200b\u5e74\u4efd\u200b\u6d4f\u89c8\u200b</p>"},{"location":"courses/map/","title":"\u5b66\u79d1\u200b\u5730\u56fe","text":""},{"location":"courses/problems/","title":"\u597d\u9898\u200b\u5899","text":"<p>\u200b\u597d\u9898\u200b\u90fd\u200b\u4ea4\u7ed9\u200b\u5b89\u5b9d\u200b\u7ba1\u7406\u200b\uff0c\u200b\u70b9\u51fb\u200b\u6253\u5f00\u200b\uff08\u200b\u76f4\u63a5\u200b\u8fdb\u200b\"\u200b\u597d\u9898\u200b\"\u200b\u5206\u7c7b\u200b\uff09\uff1a</p>  \u200b\u6253\u5f00\u200b\u597d\u9898\u200b\u9898\u5e93\u200b<p>\u200b\u5b89\u5b9d\u200b\u7ba1\u7406\u200b \u00b7 \u200b\u53ef\u5b58\u200b\u3001\u200b\u53ef\u200b\u67e5\u200b\u3001\u200b\u53ef\u200b\u5220\u200b</p>"},{"location":"games/","title":"\u5c0f\u6e38\u620f\u200b\u5408\u96c6","text":"\u5c0f\u6e38\u620f\u200b\u5408\u96c6\u200b <p>\u200b\u81ea\u5df1\u200b\u505a\u200b\u7684\u200b\u5404\u79cd\u200b\u5c0f\u6e38\u620f\u200b\uff0c\u200b\u70b9\u200b\u5361\u7247\u200b\u76f4\u63a5\u200b\u73a9\u200b\u3002</p> \u200b\u77ed\u86c7\u200b\u95ef\u5173\u200b<p>50 \u200b\u5173\u200b\u89e3\u8c1c\u200b \u00b7 \u200b\u82f9\u679c\u200b / \u200b\u4f20\u9001\u5e26\u200b / \u200b\u5f69\u8272\u200b\u95e8\u200b</p> \u200b\u5c0f\u8393\u200b\u62d6\u200b\u5c3e\u200b\u5927\u5192\u9669\u200b<p>50 \u200b\u5173\u77ed\u200b\u86c7\u200b\u89e3\u8c1c\u200b</p> \u200b\u7834\u51b0\u200b\u5c0f\u6e38\u620f\u200b<p>\u200b\u6d59\u5927\u200b\u79d1\u5b66\u200b\u8425\u200b</p> \u200b\u6570\u5b66\u200b\u7cbe\u7075\u200b \u00b7 \u200b\u5b9a\u7406\u200b\u4e4b\u5854\u200b<p>\u200b\u5361\u724c\u200b\u6570\u5b66\u200b\u6e38\u620f\u200b</p>"},{"location":"growth/","title":"\u6210\u957f\u200b\u8bb0\u5f55","text":"\u6210\u957f\u200b\u65f6\u95f4\u8f74\u200b <p>\u200b\u7ade\u8d5b\u200b\u4e0e\u200b\u9879\u76ee\u200b\u6559\u8bad\u200b\u3001\u200b\u535a\u5ba2\u200b\u6742\u8c08\u200b\u3002</p>  \u200b\u7ade\u8d5b\u200b\u4e0e\u200b\u9879\u76ee\u200b<p>\u200b\u5931\u8d25\u200b\u6559\u8bad\u200b</p>  \u200b\u535a\u5ba2\u200b\u6742\u8c08\u200b<p>\u200b\u6570\u5b66\u200b\u4e4b\u5916\u200b</p>"},{"location":"growth/blog/","title":"\u535a\u5ba2\u200b\u6742\u8c08","text":""},{"location":"growth/projects/","title":"\u7ade\u8d5b\u200b\u4e0e\u200b\u9879\u76ee","text":"\u9879\u76ee\u200b \u200b\u7ed3\u679c\u200b \u200b\u505a\u5f97\u597d\u200b\u7684\u200b \u200b\u641e\u7838\u200b\u7684\u200b \u200b\u4e0b\u6b21\u200b \uff08\u200b\u5f85\u200b\u586b\u200b\uff09"},{"location":"research/","title":"\u79d1\u7814\u200b\u5165\u95e8","text":"<p>\u200b\u79d1\u7814\u200b\u7b14\u8bb0\u200b\u3002</p>  \u200b\u8bba\u6587\u200b\u6458\u8981\u200b\u7ffb\u8bd1\u200b<p>arXiv \u200b\u4e00\u53e5\u200b\u8bdd\u200b\u6982\u62ec\u200b</p>  \u200b\u8bfb\u4e66\u200b\u62a5\u544a\u200b<p>GTM \u200b\u5361\u58f3\u200b\u70b9\u200b</p>  \u200b\u5bfc\u5e08\u200b\u8bfe\u9898\u7ec4\u200b<p>\u200b\u5bfc\u5e08\u200b\u4fe1\u606f\u200b</p>"},{"location":"research/mentors/","title":"\u5bfc\u5e08\u200b\u4e0e\u200b\u8bfe\u9898\u7ec4","text":""},{"location":"research/papers/","title":"\u8bba\u6587\u200b\u6458\u8981\u200b\u7ffb\u8bd1","text":""},{"location":"research/reading/","title":"\u8bfb\u4e66\u200b\u62a5\u544a","text":""},{"location":"resources/","title":"\u8d44\u6e90\u200b\u5bfc\u822a","text":"\u5b66\u672f\u200b\u8d44\u6e90\u200b <p>\u200b\u4e66\u5355\u200b\u4e0e\u200b\u795e\u5668\u200b\u94fe\u63a5\u200b\u3002</p>  \u200b\u4e66\u5355\u200b<p>\u200b\u6211\u200b\u7684\u200b\u6570\u5b66\u200b\u4e66\u5e93\u200b\uff08\u200b\u9700\u200b\u5bc6\u7801\u200b\uff09</p>  \u200b\u795e\u5668\u200b\u94fe\u63a5\u200b<p>\u200b\u5e38\u7528\u5de5\u5177\u200b</p>  \u200b\u5386\u5e74\u200b\u9898\u200b<p>\u200b\u5e38\u5fae\u5206\u200b \u00b7 \u200b\u70b9\u96c6\u200b\u62d3\u6251\u200b\uff08\u200b\u5b89\u5b9d\u200b\u9898\u5e93\u200b\uff09</p>"},{"location":"resources/links/","title":"\u795e\u5668\u200b\u94fe\u63a5","text":""},{"location":"resources/links/#ai","title":"\u5b89\u5b9d\u200b \u00b7 AI \u200b\u52a9\u624b","text":"<ul> <li>\u200b\u548c\u200b\u5b89\u5b9d\u200b\u804a\u5929\u200b \u2014 \u200b\u6570\u5b66\u200b\u7b54\u7591\u200b\u3001\u200b\u7cbe\u786e\u200b\u8ba1\u7b97\u200b\u3001\u200b\u5b58\u9898\u200b\u8bb2\u9898\u200b</li> <li>\u200b\u5386\u5e74\u200b\u9898\u200b \u00b7 \u200b\u9898\u5e93\u200b \u2014 \u200b\u6309\u200b \u200b\u79d1\u76ee\u200b \u2192 \u200b\u8003\u8bd5\u200b\u7c7b\u578b\u200b \u2192 \u200b\u5e74\u4efd\u200b \u200b\u6d4f\u89c8\u200b</li> </ul>"},{"location":"resources/links/#_2","title":"\u6211\u200b\u7684\u200b\u7ad9\u70b9","text":"<ul> <li>\u200b\u4e66\u5355\u200b \u2014 \u200b\u6570\u5b66\u200b\u4e66\u5e93\u200b\uff08\u200b\u9700\u200b\u5bc6\u7801\u200b\uff09</li> </ul>"},{"location":"resources/links/#_3","title":"\u5e38\u7528\u200b\u6570\u5b66\u200b\u5de5\u5177","text":"<p>\uff08\u200b\u5728\u200b\u8fd9\u91cc\u200b\u8865\u5145\u200b\u4f60\u200b\u5e38\u7528\u200b\u7684\u200b\u5de5\u5177\u200b\u94fe\u63a5\u200b\uff0c\u200b\u4f8b\u5982\u200b Desmos \u200b\u753b\u56fe\u200b\u3001WolframAlpha\u3001GeoGebra \u200b\u7b49\u200b\uff09</p>"},{"location":"toys/","title":"\u73a9\u5177\u200b\u603b\u89c8","text":"\u6570\u5b66\u200b\u73a9\u5177\u200b <p>\u200b\u8ba9\u200b\u6570\u5b66\u200b\u52a8\u200b\u8d77\u6765\u200b\u3002</p>  \u200b\u591a\u529f\u80fd\u200b\u8ba1\u7b97\u5668\u200b <p>\u200b\u516b\u79cd\u200b\u5e38\u7528\u200b\u6570\u5b66\u8ba1\u7b97\u200b\u3002</p>  3D \u200b\u753b\u56fe\u200b <p>\u200b\u81ea\u5df1\u200b\u5199\u200b\u51fd\u6570\u200b\uff0c\u200b\u751f\u6210\u200b 3D \u200b\u66f2\u9762\u200b\u3002</p>"},{"location":"toys/#_1","title":"\u73a9\u5177\u200b\u6e05\u5355","text":"<ul> <li>\u200b\u591a\u529f\u80fd\u200b\u8ba1\u7b97\u5668\u200b\uff1a\u200b\u516b\u79cd\u200b\u5e38\u7528\u200b\u6570\u5b66\u8ba1\u7b97\u200b\u3002</li> <li>3D \u200b\u753b\u56fe\u200b\uff1a\u200b\u5199\u200b\u51fd\u6570\u200b\u751f\u6210\u200b\u66f2\u9762\u200b\uff0c\u200b\u62d6\u52a8\u200b\u65cb\u8f6c\u200b\u3002</li> </ul>"},{"location":"toys/visualization/","title":"3D \u200b\u753b\u56fe","text":"<p>\u200b\u5199\u200b\u51fd\u6570\u200b\u753b\u200b 3D \u200b\u56fe\u200b\u3002\u200b\u4e09\u79cd\u200b\u6a21\u5f0f\u200b\uff1a<code>z=f(x,y)</code>\u3001\u200b\u53c2\u6570\u200b\u66f2\u9762\u200b\u3001\u200b\u9690\u5f0f\u200b\u65b9\u7a0b\u200b <code>f(x,y,z)=0</code>\u3002\u200b\u6309\u4f4f\u200b\u62d6\u52a8\u200b\u65cb\u8f6c\u200b\u3002</p>  \u200b\u753b\u200b\u4e00\u4e2a\u200b 3D \u200b\u56fe\u200b <p>  \u200b\u9009\u200b\u6a21\u5f0f\u200b \u200b\u5199\u200b\u51fd\u6570\u200b\u6216\u70b9\u200b\u9884\u8bbe\u200b \u200b\u56de\u8f66\u200b\u6216\u70b9\u200b\"\u200b\u751f\u6210\u200b\"\uff1bx\u00b2 \u200b\u5199\u200b x*x \u200b\u6216\u200b x**2\uff0c\u03c0 \u200b\u5199\u200b pi  </p> z = f(x, y) \u200b\u53c2\u6570\u200b\u66f2\u9762\u200b \u200b\u9690\u5f0f\u200b\u65b9\u7a0b\u200b \u200b\u6ce2\u6d6a\u200b sin(x)\u00b7cos(y) \u200b\u8d77\u4f0f\u200b sin(x)+sin(y) \u200b\u629b\u7269\u9762\u200b x\u00b2+y\u00b2 \u200b\u9a6c\u978d\u200b\u9762\u200b x\u00b2\u2212y\u00b2 \u200b\u534a\u7403\u200b \u221a(9\u2212x\u00b2\u2212y\u00b2) \u200b\u9525\u9762\u200b \u221a(x\u00b2+y\u00b2) \u200b\u87ba\u65cb\u9762\u200b atan2(y,x) \u200b\u5c0f\u200b\u5c71\u4e18\u200b e^(\u2212x\u00b2\u2212y\u00b2) \u200b\u6c34\u6ce2\u7eb9\u200b \u200b\u53cc\u5cf0\u200b z = \u200b\u751f\u6210\u200b \u200b\u73af\u9762\u200b \u200b\u7403\u9762\u200b \u200b\u5706\u67f1\u200b \u200b\u5706\u9525\u200b \u200b\u83ab\u6bd4\u200b\u4e4c\u65af\u5e26\u200b \u200b\u87ba\u65cb\u7ba1\u200b x = y = z = u: v: \u200b\u751f\u6210\u200b \u200b\u7403\u9762\u200b \u200b\u692d\u7403\u200b \u200b\u5706\u67f1\u200b \u200b\u53cc\u9525\u200b \u200b\u5355\u53f6\u200b\u53cc\u66f2\u9762\u200b \u200b\u53cc\u53f6\u200b\u53cc\u66f2\u9762\u200b \u200b\u73af\u9762\u200b \u200b\u5fc3\u810f\u200b\u66f2\u9762\u200b f = \u200b\u751f\u6210\u200b \u200b\u8303\u56f4\u200b \u00b1 <p> \u200b\u6309\u4f4f\u200b\u62d6\u52a8\u200b\u65cb\u8f6c\u200b \u00b7 \u200b\u56de\u8f66\u200b\u6216\u70b9\u200b\"\u200b\u751f\u6210\u200b\"\u200b\u91cd\u753b\u200b</p> <p></p>"}]}